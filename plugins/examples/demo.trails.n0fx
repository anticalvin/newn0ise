{"n0fx":1,"id":"demo.trails","name":"Light Trails","version":"1.0.0","apiVersion":1,"author":"demo","licence":"CC0-1.0","kind":"effect","family":"Community","feedback":true,"description":"Bright things leave fading trails. Uses the previous frame.",
 "params":[{"k":"len","t":"r","label":"Trail length","min":0,"max":98,"def":88,"hero":true},{"k":"thr","t":"r","label":"Only brighter than","min":0,"max":100,"def":55,"hero":true},{"k":"drift","t":"r","label":"Drift","min":0,"max":100,"def":10,"hero":true}],
 "glsl":"vec4 fx(vec2 uv){\n  vec3 cur=texture(uSrc,uv).rgb;\n  vec3 old=texture(u_prev,uv+vec2(0.,u_drift/100.*.004)).rgb;\n  float b=smoothstep(u_thr/100.,u_thr/100.+.15,luma(cur));\n  vec3 c=max(cur*(1.-.0),old*u_len/100.*b+cur*(1.-b)*.0+old*u_len/100.*(1.-b)*.6);\n  if(u_reset>.5)c=cur;\n  return vec4(max(c,cur*.85),1.);\n}"}
