{"n0fx":1,"id":"demo.plasma","name":"Plasma","version":"1.0.0","apiVersion":1,"author":"demo","licence":"CC0-1.0","kind":"generator","family":"Source","description":"A moving colour field that needs no picture.",
 "params":[{"k":"scale","t":"r","label":"Scale","min":1,"max":30,"def":8,"hero":true},{"k":"spd","t":"r","label":"Speed","min":0,"max":100,"def":30,"hero":true},{"k":"c1","t":"color","label":"Colour A","def":"#ff5a1f"},{"k":"c2","t":"color","label":"Colour B","def":"#1f3bff"}],
 "glsl":"vec4 fx(vec2 uv){\n  vec2 p=uv*u_scale;float t=uTime*u_spd/20.;\n  float v=sin(p.x+t)+sin(p.y*1.3-t*1.2)+sin((p.x+p.y)*.7+t*.6)+sin(length(p-u_scale*.5)*1.1-t);\n  return vec4(mix(u_c1,u_c2,.5+.25*v),1.);\n}"}
