{"n0fx":1,"id":"demo.splitrgb","name":"Split RGB","version":"1.0.0","apiVersion":1,"author":"demo","licence":"CC0-1.0","kind":"effect","family":"Community","description":"Pulls the colour channels apart sideways.",
 "params":[{"k":"amt","t":"r","label":"Distance","min":0,"max":100,"def":35,"hero":true},{"k":"ang","t":"r","label":"Angle","min":0,"max":360,"def":0,"hero":true},{"k":"mix","t":"r","label":"Blend","min":0,"max":100,"def":100,"hero":true}],
 "glsl":"vec4 fx(vec2 uv){\n  float a=radians(u_ang);vec2 d=vec2(cos(a),sin(a))*u_amt/100.*.02;\n  vec3 c=vec3(texture(uSrc,uv+d).r,texture(uSrc,uv).g,texture(uSrc,uv-d).b);\n  return vec4(mix(texture(uSrc,uv).rgb,c,u_mix/100.),1.);\n}"}
