 "rules": [
  {
   "id": "hello",
   "when": {
    "trigger": "timer",
    "after": 1
   },
   "then": [
    {
     "action": "show-message",
     "text": "Night Station. Walk to the shop, press E at the counter to take the pistol, then click or F to shoot.",
     "seconds": 8
    }
   ]
  },
  {
   "id": "door",
   "when": {
    "trigger": "player-interact",
    "target": "shopdoor"
   },
   "then": [
    {
     "action": "toggle-open",
     "target": "shopdoor"
    },
    {
     "action": "play-sound",
     "sound": "click"
    }
   ]
  },
  {
   "id": "take",
   "when": {
    "trigger": "player-interact",
    "target": "pistol_pickup"
   },
   "then": [
    {
     "action": "collect",
     "target": "pistol_pickup"
    },
    {
     "action": "set-flag",
     "flag": "armed",
     "value": true
    },
    {
     "action": "show-message",
     "text": "You have the demo pistol. Click or F to fire.",
     "seconds": 5
    },
    {
     "action": "play-sound",
     "sound": "chime"
    }
   ]
  }
 ],
 "looks": [
  {
   "target": "object:tvscreen",
   "profile": "crt"
  }
 ]
}