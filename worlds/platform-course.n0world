 ],
 "rules": [
  {
   "id": "c1",
   "when": {
    "trigger": "object-touch",
    "target": "coin1"
   },
   "then": [
    {
     "action": "collect",
     "target": "coin1"
    },
    {
     "action": "set-flag",
     "flag": "coin1",
     "value": true
    }
   ]
  },
  {
   "id": "c2",
   "when": {
    "trigger": "object-touch",
    "target": "coin2"
   },
   "then": [
    {
     "action": "collect",
     "target": "coin2"
    },
    {
     "action": "set-flag",
     "flag": "coin2",
     "value": true
    }
   ]
  },
  {
   "id": "c3",
   "when": {
    "trigger": "object-touch",
    "target": "coin3"
   },
   "then": [
    {
     "action": "collect",
     "target": "coin3"
    },
    {
     "action": "set-flag",
     "flag": "coin3",
     "value": true
    }
   ]
  },
  {
   "id": "c4",
   "when": {
    "trigger": "object-touch",
    "target": "coin4"
   },
   "then": [
    {
     "action": "collect",
     "target": "coin4"
    },
    {
     "action": "set-flag",
     "flag": "coin4",
     "value": true
    }
   ]
  },
  {
   "id": "win",
   "when": {
    "trigger": "player-enter",
    "target": "goal"
   },
   "if": {
    "flag": "coin4",
    "equals": true
   },
   "then": [
    {
     "action": "show-message",
     "text": "You collected the last coin. Well done!",
     "seconds": 4
    },
    {
     "action": "play-sound",
     "sound": "chime"
    }
   ]
  }
 ]
}