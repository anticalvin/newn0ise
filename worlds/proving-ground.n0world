   ],
   "fov": 55
  }
 ],
 "rules": [
  {
   "id": "hello",
   "when": {
    "trigger": "timer",
    "after": 1
   },
   "then": [
    {
     "action": "show-message",
     "text": "E near the car to drive. Click or F to shoot. Climb the ladder and the left wall.",
     "seconds": 6
    }
   ]
  },
  {
   "id": "s1",
   "when": {
    "trigger": "object-shot",
    "target": "t1",
    "once": true
   },
   "then": [
    {
     "action": "set-flag",
     "flag": "t1",
     "value": true
    }
   ]
  },
  {
   "id": "s2",
   "when": {
    "trigger": "object-shot",
    "target": "t2",
    "once": true
   },
   "then": [
    {
     "action": "set-flag",
     "flag": "t2",
     "value": true
    }
   ]
  },
  {
   "id": "s3",
   "when": {
    "trigger": "object-shot",
    "target": "t3",
    "once": true
   },
   "then": [
    {
     "action": "set-flag",
     "flag": "t3",
     "value": true
    }
   ]
  },
  {
   "id": "open",
   "when": {
    "trigger": "object-shot",
    "target": "t4",
    "once": true
   },
   "if": {
    "flag": "t3",
    "equals": true
   },
   "then": [
    {
     "action": "toggle-open",
     "target": "gate",
     "state": "open"
    },
    {
     "action": "show-message",
     "text": "The gate opened. Drive through it!",
     "seconds": 4
    },
    {
     "action": "play-sound",
     "sound": "chime"
    }
   ]
  },
  {
   "id": "win",
   "when": {
    "trigger": "player-enter",
    "target": "goal",
    "once": true
   },
   "then": [
    {
     "action": "show-message",
     "text": "Proving ground complete.",
     "seconds": 5
    },
    {
     "action": "play-sound",
     "sound": "chime"
    }
   ]
  }
 ]
}