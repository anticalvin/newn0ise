   "step": 0.05
  },
  {
   "k": "bend",
   "label": "Wind bend",
   "min": 0,
   "max": 2,
   "def": 0.9,
   "step": 0.01
  },
  {
   "k": "leaves",
   "label": "Leaves per plant",
   "min": 0,
