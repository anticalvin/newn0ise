{
 "n0form": 1,
 "id": "n0ise.impossible-garden",
 "name": "The Impossible Garden",
 "version": "1.0.0",
 "apiVersion": 1,
 "author": "n0ise",
 "licence": "CC0-1.0",
 "description": "FORM 001. Plants that grow when you open it, stems that loop where they shouldn't, grass, and floating lights.",
 "seed": 2026,
 "params": [
  {
   "k": "plants",
   "label": "Plants",
   "min": 1,
   "max": 80,
   "def": 26,
   "step": 1
  },
